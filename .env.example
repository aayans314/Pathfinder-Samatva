# Required for auth (Google/OAuth). Copy this file to .env.local — do not use placeholder hosts.
# Supabase → Project Settings → API: Project URL + anon public key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Production site URL (set this in Vercel Environment Variables)
# Must match EXACTLY what you set in Supabase → Authentication → Site URL
# e.g. https://pathfinder-samatva.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar integration (optional — only needed if using calendar sync)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
